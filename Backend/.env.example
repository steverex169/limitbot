# Runtime
APP_ENV=production
HOST=0.0.0.0
PORT=8000
TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LIMITBOT_ENCRYPTION_KEY=

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=limitbotdb

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# External odds comparison (server-side only)
ODDSPAPI_KEY=

# Pinnacle lines and limits, for Build a Ramp and the recorded curve.
# The Pinnacle betting engine behind api.probet42.com; read-only, and used
# only for /v3/sports, /v3/leagues, /v3/fixtures and /v4/odds.
PINNACLE_API_BASE=https://api.probet42.com
PINNACLE_API_USERNAME=
PINNACLE_API_PASSWORD=
# Pinnacle's edge refuses datacenter addresses, so a server needs a proxy on an
# ordinary one. Either a full URL or the host:port:user:password line the proxy
# vendor gives you. Leave empty when running from a machine it already accepts.
PINNACLE_API_PROXY=
